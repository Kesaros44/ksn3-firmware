#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
        inc_dec_bl: inc_dec_bl {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bl BL_INC>, <&bl BL_DEC>;
        };

        /* Windows 계산기 실행 매크로: KSN-1과 동일 (GUI+R -> "calc" -> Enter).
           왼쪽(peripheral) col1 row2 위치에 바인딩됨 (default_layer). */
        calc_macro: calc_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp R>
                , <&macro_wait_time 100>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 300>
                , <&macro_tap &kp C &kp A &kp L &kp C &kp RET>
                ;
        };

        /* macOS 계산기 실행 매크로: KSN-1과 동일 (Cmd+Space -> "calculator" -> Enter).
           같은 위치의 mac_layer 바인딩. */
        mac_calc_macro: mac_calc_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp SPACE>
                , <&macro_wait_time 100>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 400>
                , <&macro_tap &kp C &kp A &kp L &kp C &kp U &kp L &kp A &kp T &kp O &kp R>
                , <&macro_wait_time 300>
                , <&macro_tap &kp RET>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* 오른쪽(central)에만 인코더 있음: 볼륨 업/다운 */
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
                &none          &none          &kp DEL        &kp BSPC       &kp ESC        &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &none          &none          &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F11        &kp F12        &kp PSCRN      &kp C_MUTE     &none         
                &calc_macro    &kp KP_DIVIDE  &kp GRAVE      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp HOME       &kp PG_UP      &kp N8         &kp N9         &kp N0         &kp MINUS      &kp EQUAL      &none          &kp BSPC       &kp INS        &kp PG_DN      &none         
                &kp KP_N7      &kp KP_N8      &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &none          &kp PG_DN      &kp I          &kp O          &kp P          &kp LBKT       &kp RBKT       &kp BSLH       &kp DEL        &kp END        &kp PG_UP      &none         
                &kp KP_N4      &kp KP_N5      &kp CLCK       &none          &kp A          &kp S          &kp D          &kp F          &kp G          &kp H          &none          &kp INS        &kp J          &kp K          &kp L          &kp SEMI       &kp SQT        &none          &kp RET        &kp RSHFT      &kp UP         &none         
                &kp KP_N1      &kp KP_N2      &kp LSHFT      &kp Z          &kp X          &kp C          &none          &kp V          &kp B          &kp N          &kp END        &kp DEL        &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT      &none          &kp K_APP      &kp UP         &none          &none         
                &kp KP_N0      &none          &kp LCTRL      &none          &kp LGUI       &kp LALT       &none          &kp SPACE      &mo 1          &none          &kp DEL        &kp END        &none          &kp RALT       &mo 1          &kp RGUI       &kp K_APP      &kp RCTRL      &kp LEFT       &kp DOWN       &kp RIGHT      &none                     >;
        };

        func_layer {
            sensor-bindings = <&inc_dec_bl>;
            bindings = <
                &none          &none          &trans         &trans         &trans         &trans         &trans         &trans         &trans         &bt BT_CLR     &none          &none          &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none         
                &trans         &trans         &trans         &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &out OUT_TOG   &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none          &trans         &trans         &trans         &none         
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none          &tog 2         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none         
                &trans         &trans         &trans         &none          &trans         &trans         &trans         &trans         &trans         &trans         &none          &trans         &trans         &trans         &trans         &trans         &trans         &none          &trans         &trans         &trans         &none         
                &trans         &trans         &trans         &trans         &trans         &trans         &none          &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none          &trans         &trans         &none          &none         
                &trans         &none          &trans         &none          &trans         &trans         &none          &trans         &trans         &none          &trans         &trans         &none          &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none                     >;
        };

        mac_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
                &none          &none          &kp DEL        &kp BSPC       &kp ESC        &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &kp C_PREV     &kp C_PP       &kp C_NEXT     &none          &none          &kp C_VOL_DN   &kp C_VOL_UP   &none          &none          &none          &none          &none          &none          &kp C_MUTE     &none         
                &mac_calc_macro &kp KP_DIVIDE  &kp GRAVE      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp HOME       &kp PG_UP      &kp N8         &kp N9         &kp N0         &kp MINUS      &kp EQUAL      &none          &kp BSPC       &kp INS        &kp PG_DN      &none         
                &kp KP_N7      &kp KP_N8      &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &none          &kp PG_DN      &kp I          &kp O          &kp P          &kp LBKT       &kp RBKT       &kp BSLH       &kp DEL        &kp END        &kp PG_UP      &none         
                &kp KP_N4      &kp KP_N5      &kp CLCK       &none          &kp A          &kp S          &kp D          &kp F          &kp G          &kp H          &none          &kp INS        &kp J          &kp K          &kp L          &kp SEMI       &kp SQT        &none          &kp RET        &kp RSHFT      &kp UP         &none         
                &kp KP_N1      &kp KP_N2      &kp LSHFT      &kp Z          &kp X          &kp C          &none          &kp V          &kp B          &kp N          &kp END        &kp DEL        &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT      &none          &kp K_APP      &kp UP         &none          &none         
                &kp KP_N0      &none          &kp LCTRL      &none          &kp LALT       &kp LGUI       &none          &kp SPACE      &mo 1          &none          &kp DEL        &kp END        &none          &kp RGUI       &mo 1          &kp RALT       &kp K_APP      &kp RCTRL      &kp LEFT       &kp DOWN       &kp RIGHT      &none                     >;
        };
    };
};
