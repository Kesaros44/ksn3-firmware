#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan            = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,backlight        = &backlight;
        /* zmk,battery 는 nice!nano v2 보드 기본값(zmk,battery-nrf-vddh, 내장 VDDH 센싱)을
           그대로 사용 - KSN-1/KSN-2에서 이미 겪은 외부 분배저항 부정확 문제(528mV/0%
           같은 값)를 피하기 위해 커스텀 vbatt 노드는 처음부터 추가하지 않음. */
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <22>;
        rows    = <6>;
        map = <
RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10)   RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20) RC(0,21)
RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10)   RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18) RC(1,19) RC(1,20) RC(1,21)
RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10)   RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17) RC(2,18) RC(2,19) RC(2,20) RC(2,21)
RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10)   RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17) RC(3,18) RC(3,19) RC(3,20) RC(3,21)
RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10)   RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18) RC(4,19) RC(4,20) RC(4,21)
RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(5,9)  RC(5,10)   RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16) RC(5,17) RC(5,18) RC(5,19) RC(5,20) RC(5,21)
        >;
    };

    /* 매트릭스: 6행 x 22열 (11열/half), col2row.
       row/col GPIO는 스키매틱(SCH_KSN3L/R json)에서 넷라벨-핀 좌표 매칭으로
       직접 추출 - 양쪽 half가 동일한 핀을 사용 (KSN-1/2와 동일 패턴).
       row=입력이라 PULL_DOWN 필요 (KSN-2에서 겪은 row/col 풀 반전 유령입력
       버그 재발 방지 차원에서 row에만 명시적으로 PULL_DOWN 부여). */
    kscan0: kscan {
        compatible      = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row1 = P1.00 */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row2 = P0.24 */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row3 = P0.22 */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row4 = P0.17 */
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row5 = P0.08 */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row6 = P0.20 */
            ;

        col-gpios
            = <&gpio0 11 GPIO_ACTIVE_HIGH>   /* col1  = P0.11 */
            , <&gpio1 4  GPIO_ACTIVE_HIGH>   /* col2  = P1.04 */
            , <&gpio1 6  GPIO_ACTIVE_HIGH>   /* col3  = P1.06 */
            , <&gpio1 1  GPIO_ACTIVE_HIGH>   /* col4  = P1.01 */
            , <&gpio1 2  GPIO_ACTIVE_HIGH>   /* col5  = P1.02 */
            , <&gpio1 7  GPIO_ACTIVE_HIGH>   /* col6  = P1.07 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* col7  = P1.15 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* col8  = P1.13 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>   /* col9  = P1.11 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>   /* col10 = P0.10 */
            , <&gpio0 9  GPIO_ACTIVE_HIGH>   /* col11 = P0.09 */
            ;
    };
};
